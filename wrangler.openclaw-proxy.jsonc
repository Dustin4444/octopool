{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "octopool-openclaw-proxy",
  "account_id": "91b59577e757131d68d55a471fe32aca",
  "main": "src/openclaw-proxy.ts",
  "compatibility_date": "2026-05-26",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "OCTOPOOL_ORIGIN": "https://octopool.dev",
  },
  // octopool.openclaw.ai is served directly by the octopool Worker now; this
  // proxy stays only until the octopool.dev teardown finishes.
}
